[sub_resource type="GDScript" id="GDScript_fnvcv"]
script/source = "extends Node

@export var player_spawner: NetPlayerSpawner
@export var player_prefab: PackedScene

@export var spawn_btn: Button

@export_group(\"Info\")
@export var is_server:bool = false

func _ready() -> void:
	is_server = multiplayer.is_server()
	spawn_btn.pressed.connect(on_spawn_btn_pressed)

func on_spawn_btn_pressed() -> void:
	if !GDNet.IsConnectedToServer(): await GDNet.OnNetworkReady
	player_spawner.RequestSpawn(player_prefab.resource_path)
	spawn_btn.hide()
"

