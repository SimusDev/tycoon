[sub_resource type="Shader" id="Shader_1m3ve"]
code = "shader_type spatial;
render_mode blend_mix, cull_back;

// Настройки эффекта
uniform float time_scale  = 1.0;   // скорость анимации
uniform float wave_amp    = 0.08;  // амплитуда искажения вершин
uniform float wave_freq   = 2.5;   // частота волн
uniform float wobble_speed = 3.0;  // скорость подёргивания размера

void vertex() {
	// 1. \"Желейное\" смещение вершин по нормали
	float wave = sin(TIME * time_scale + VERTEX.x * wave_freq + VERTEX.y * 1.2) * wave_amp;
	VERTEX += NORMAL * wave;

	// 2. Смешное подёргивание размера (всё тело пульсирует)
	float pulse = 1.0 + 0.03 * sin(TIME * wobble_speed + VERTEX.z * 3.0);
	VERTEX *= pulse;
}

void fragment() {
	// 3. Радужный перелив – смешиваем три канала с разным сдвигом
	vec3 rainbow = 0.5 + 0.5 * cos(TIME * 0.4 + vec3(0.0, 2.0, 4.0) + UV.x * 8.0 + UV.y * 6.0);
	
	// 4. Хаотичное мерцание яркости (как будто материал живой)
	float flicker = 0.7 + 0.3 * sin(TIME * 5.0 + UV.y * 15.0 + UV.x * 10.0);
	ALBEDO = rainbow * flicker;

	// 5. Лёгкое свечение (чтобы было ещё забавнее)
	EMISSION = rainbow * 0.1 * (0.5 + 0.5 * sin(TIME * 2.0));
}"

