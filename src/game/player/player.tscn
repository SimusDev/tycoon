[sub_resource type="GDScript" id="GDScript_0r077"]
script/source = "extends Node3D

@onready var state_machine: StateMachine = $\"../../StateMachine\"
@onready var animation_player: AnimationPlayer = $AnimationPlayer

@export var anim_prefix:StringName = &\"\"

func _ready() -> void:
	state_machine.StateEnter.connect(_on_state_enter)
	
	var auth = is_multiplayer_authority()
	set_process(auth)
	set_process_input(auth)
	if !auth:
		return

func _input(_event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"Hello\"):
		play_animation.rpc(anim_prefix + \"Helo\")

@rpc(\"authority\", \"call_local\")
func play_animation(anim_name: String) -> void:
	animation_player.play(anim_name)

func _on_state_enter(state_name: String) -> void:
	var anim_name:String = anim_prefix + state_name
	if !animation_player.has_animation(anim_name):
		return
	
	animation_player.play(anim_name)
"

